# Переменные воркера Sonar. Скопировать в .env.worker и заполнить.
# Значения передаёт владелец проекта — не через обычный мессенджер.

NODE_ENV=production

# Postgres (Neon) — откуда воркер берёт задачи
DATABASE_URL=

# Whisper (расшифровка) и LLM (разбор рилсов)
OPENAI_API_KEY=

# Cloudflare R2 — исходники и готовые видео
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
