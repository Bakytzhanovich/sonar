# Переменные воркера Sonar. Скопировать в .env.worker и заполнить.
# Значения передаёт владелец проекта — не через обычный мессенджер.

NODE_ENV=production

# Обязателен, хотя воркер не подписывает сессии: без него процесс падает при
# старте (src/auth.ts). При хранилище R2 значение ни на что не влияет, поэтому
# сюда — новое случайное (openssl rand -hex 32), НЕ секрет сессий API:
# с ним можно подделать вход в любой аккаунт.
SESSION_SECRET=

# Postgres (Neon) — откуда воркер берёт задачи
DATABASE_URL=

# Whisper (расшифровка) и LLM (разбор рилсов)
OPENAI_API_KEY=

# Cloudflare R2 — исходники и готовые видео
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
