# Адрес бэкенда Sonar. На Vercel — домен сервиса с Render,
# например https://sonar-api.onrender.com (без слеша в конце).
# Локально можно не задавать: код падает обратно на http://localhost:4001.
NEXT_PUBLIC_API_BASE_URL=

# Публичный домен самого фронтенда. Нужен для корректных og:image и
# ссылок-превью — без него Next.js разрешает относительные URL
# относительно localhost.
NEXT_PUBLIC_SITE_URL=
