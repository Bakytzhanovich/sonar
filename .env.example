# ---- Обязательные ----------------------------------------------------------
DATABASE_URL=postgresql://sonar:sonar@localhost:5435/sonar
# Подписывает сессионные JWT. Без него сервер не стартует (кроме тестов) —
# дефолт позволил бы подделать сессию любого тенанта.
SESSION_SECRET=change-me
PORT=4001

# Домен фронтенда. В проде — конкретный origin, не '*'.
CORS_ORIGIN=*

# ---- Прокси ----------------------------------------------------------------
# Число доверяемых hop'ов X-Forwarded-For. 0 локально, 1 за прокси Render.
# Не выставляй >0 без реального прокси: иначе rate limit обходится подделкой
# заголовка.
TRUST_PROXY=0

# ---- Мок-вебхук Instagram (только разработка/демо) -------------------------
# Симулятор Meta. Выключен по умолчанию: открытым он даёт кому угодно
# отправлять DM от имени аккаунта клиента и засевать его CRM.
# Включённый без секрета — сервер откажется стартовать.
MOCK_WEBHOOK_ENABLED=false
MOCK_WEBHOOK_SECRET=

# ---- Push-уведомления ------------------------------------------------------
# Сгенерировать пару:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Без них ключи пишутся в data/vapid-keys.json — только для локальной работы:
# на эфемерной ФС Render это убивает все подписки браузеров при каждом деплое.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Опционально ----------------------------------------------------------
# Без ключа Модуль 4 использует мок-генерацию.
OPENAI_API_KEY=
