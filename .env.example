# ---- Обязательные ----------------------------------------------------------
DATABASE_URL=postgresql://sonar:sonar@localhost:5435/sonar
# Подписывает сессионные JWT. Без него сервер не стартует (кроме тестов) —
# дефолт позволил бы подделать сессию любого тенанта.
SESSION_SECRET=change-me
PORT=4001

# Домен фронтенда. В проде — конкретный origin, не '*'.
CORS_ORIGIN=*

# ---- Прокси ----------------------------------------------------------------
# Число доверяемых hop'ов X-Forwarded-For. 0 локально, 1 за прокси Render.
# Не выставляй >0 без реального прокси: иначе rate limit обходится подделкой
# заголовка.
TRUST_PROXY=0

# ---- Мок-вебхук Instagram (только разработка/демо) -------------------------
# Симулятор Meta. Выключен по умолчанию: открытым он даёт кому угодно
# отправлять DM от имени аккаунта клиента и засевать его CRM.
# Включённый без секрета — сервер откажется стартовать.
MOCK_WEBHOOK_ENABLED=false
MOCK_WEBHOOK_SECRET=

# ---- Push-уведомления ------------------------------------------------------
# Сгенерировать пару:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Без них ключи пишутся в data/vapid-keys.json — только для локальной работы:
# на эфемерной ФС Render это убивает все подписки браузеров при каждом деплое.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Опционально ----------------------------------------------------------
# Без ключа Модуль 4 использует мок-генерацию.
OPENAI_API_KEY=

# ---- Модуль 8, уровень 3: собственный монтажный движок ---------------------
# S3-совместимое хранилище (Cloudflare R2 / S3 / MinIO) — единственное место,
# где проект работает с байтами видео. Без этих переменных API отвечает 503 на
# POST /api/video-uploads, а воркер отказывается стартовать (иначе он бы
# проваливал каждую взятую задачу по одной).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
# R2 не использует регион, но требует синтаксически валидный в scope подписи.
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Публичный домен готовых рендеров. Не задан — клиент получает presigned-ссылку
# со сроком жизни в неделю.
STORAGE_PUBLIC_BASE_URL=

# Транскрибация (Whisper API). Уже используется выше для LLM-модулей.
# OPENAI_API_KEY=

# Воркер рендера (npm run worker). Одна задача на процесс: параллельные
# кодирования на малой машине замедляют обе, не ускоряя ни одну.
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=5000
# Пути к бинарникам, если они не на PATH (в Docker-образе — на PATH).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Семейство шрифта для вжигаемых субтитров. Должно реально существовать в
# системе: libass молча подставит другой шрифт и ничего не напишет в лог.
# В Docker-образе установлен Montserrat, и сборка падает, если его нет.
SUBTITLE_FONT=Montserrat

# ---- Локальное хранилище видео (только разработка) -------------------------
# Если STORAGE_* не заданы, загрузки и рендеры ложатся на диск, и уровень 3
# работает без R2. В production режим выключен: ФС контейнера стирается при
# каждом деплое, и видео клиента бы потерялось.
LOCAL_MEDIA_DIR=data/media
# Адрес, по которому браузер достучится до этого API (ссылки на результат).
LOCAL_MEDIA_BASE_URL=http://localhost:4001

# ---- Распознавание речи: казахский и смешанная речь ------------------------
# Whisper (OPENAI_API_KEY выше) казахский НЕ распознаёт — проверено на реальном
# ролике: выдаёт фонетическую кашу, и language=kk не помогает. gpt-4o-transcribe
# слышит лучше, но не отдаёт пословные таймкоды, без которых Smart Cut
# невозможен. Поэтому для казахского — Google Speech-to-Text.
#
# Ключ: console.cloud.google.com → включить Cloud Speech-to-Text API →
# APIs & Services → Credentials → Create credentials → API key.
# Обычный API-ключ, не service account: JSON монтировать в воркер не нужно.
# Ключ стоит ограничить (Restrict key) только Speech-to-Text API.
#
# Не задан — работает Whisper, как раньше (русский/английский он знает хорошо).
GOOGLE_SPEECH_API_KEY=

# Основной язык распознавания.
GOOGLE_SPEECH_LANGUAGE=kk-KZ
# Языки, на которые движок может переключиться ПОСРЕДИ файла (до 3, через
# запятую). Это главная причина выбора Google: в Казахстане регулярно говорят
# на казахском и русском в одной фразе, а движок с одним языком калечит ту
# половину, которую не выбрал.
GOOGLE_SPEECH_ALT_LANGUAGES=ru-RU
